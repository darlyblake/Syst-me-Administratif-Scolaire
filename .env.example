# Supabase public browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional: canonical production URL used for auth redirects when window.location.origin is unavailable
NEXT_PUBLIC_APP_URL=https://YOUR_PRODUCTION_DOMAIN

# Server-only: NEVER expose these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
CRON_SECRET=YOUR_RANDOM_CRON_SECRET
